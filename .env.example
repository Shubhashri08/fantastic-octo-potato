# ==============================================================================
# VIGRAH AI — CONFIGURATION & DATABASE ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STRUCTURED DATABASE (PostgreSQL / Neon DB / SQLite)
# ------------------------------------------------------------------------------
# For local development with SQLite (Default):
DATABASE_URL=sqlite:///./vigrah.db

# For Cloud / Production PostgreSQL (e.g. Neon DB):
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[dbname]?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:npg_xyz@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. OBJECT STORAGE & DIRECTORIES (Clips, Snapshots & Evidence)
# ------------------------------------------------------------------------------
MEDIA_STORAGE_DIR=./recordings
SNAPSHOTS_STORAGE_DIR=./snapshots
EVIDENCE_STORAGE_DIR=./evidence

# ------------------------------------------------------------------------------
# 3. DETECTION & RE-ID INFERENCE SETTINGS
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CONF_THRESHOLD=0.35
TEMPORAL_PERSISTENCE_FRAMES=3
INCIDENT_COOLDOWN_SECONDS=10
PERSON_REID_FRAME_SAMPLING_FPS=3
PERSON_REID_DEFAULT_TOP_K=5
