GEMINI_MODEL=gemini-1.5-flash

# Default Admin Bootstrap
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=VigrahAdminPassword2026!

# Upstream Integration Settings (Layer 3 & Layer 4)
