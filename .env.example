# ==============================================================================
# VIGRAH AI — CONFIGURATION & DATABASE ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STRUCTURED DATABASE (PostgreSQL / Neon DB / SQLite)
# ------------------------------------------------------------------------------
# PostgreSQL / Neon DB format:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint-hostname]/[dbname]?sslmode=require
#
# Local SQLite default:
DATABASE_URL=sqlite:///./vigrah.db

# ------------------------------------------------------------------------------
# 2. PERSON RE-IDENTIFICATION (Re-ID) CONFIGURATION
# ------------------------------------------------------------------------------
# Supported backends: 'transreid', 'osnet'
PERSON_REID_MODEL=transreid
# Optional checkpoint path override:
# PERSON_REID_CHECKPOINT=./weights/transreid_market1501.pth
# Device override ('cuda', 'mps', 'cpu'):
# PERSON_REID_DEVICE=cpu

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE & MEDIA DIRECTORIES
# ------------------------------------------------------------------------------
MEDIA_STORAGE_DIR=./recordings
SNAPSHOTS_STORAGE_DIR=./snapshots

# ------------------------------------------------------------------------------
# 4. SERVER & STREAMING SETTINGS
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CONF_THRESHOLD=0.35
TEMPORAL_PERSISTENCE_FRAMES=3
INCIDENT_COOLDOWN_SECONDS=10
