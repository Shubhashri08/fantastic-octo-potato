# Track essential detection & classification models (<15MB each, GitHub compatible)
!backend/yolo11n.pt
!backend/weights/best.onnx
!backend/weights/osnet_x1_0_market1501.pth
!backend/weights/test_osnet.pth
!backend/weights/.gitkeep

